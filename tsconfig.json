{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@hypercarrier/auto-compact-durable/keepset": ["./src/keepset.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
